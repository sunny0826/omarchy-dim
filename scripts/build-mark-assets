#!/usr/bin/python3
"""Build plugin assets from the official DimAgent PNG and favicon SVG.

The app icon keeps its white artwork and native transparency. Bar marks use
the official vector path, in brand green or white for the shell to tint.

Run:
  scripts/build-mark-assets
  scripts/build-mark-assets --source logo.png --mark-source favicon.svg
"""

import argparse
import os
import struct
import sys
import urllib.request
import zlib
import xml.etree.ElementTree as ET
from pathlib import Path

LOGO_URL = "https://dimagent.cn/dim/logo.png"
MARK_URL = "https://dimagent.cn/dimagent-favicon.svg"
PLUGIN_ROOT = Path(__file__).resolve().parent.parent


# ---------------------------------------------------------------------- PNG


def read_png(path):
  """(width, height, RGBA bytes) for an 8-bit non-interlaced RGBA PNG."""
  data = path.read_bytes()
  if data[:8] != b"\x89PNG\r\n\x1a\n":
    raise SystemExit(f"{path} is not a PNG")
  pos, idat, header = 8, b"", None
  while pos < len(data):
    length, kind = struct.unpack(">I4s", data[pos:pos + 8])
    body = data[pos + 8:pos + 8 + length]
    pos += 12 + length
    if kind == b"IHDR":
      header = struct.unpack(">IIBBBBB", body)
    elif kind == b"IDAT":
      idat += body
    elif kind == b"IEND":
      break
  if header is None:
    raise SystemExit(f"{path} has no IHDR")
  width, height, depth, color_type, _, _, interlace = header
  if depth != 8 or color_type != 6 or interlace != 0:
    raise SystemExit(f"unsupported PNG ({header}); expected 8-bit RGBA, non-interlaced")

  raw = zlib.decompress(idat)
  stride = width * 4
  out = bytearray(stride * height)
  prev = bytearray(stride)
  cursor = 0
  for y in range(height):
    ftype = raw[cursor]
    cursor += 1
    line = bytearray(raw[cursor:cursor + stride])
    cursor += stride
    if ftype == 1:
      for i in range(4, stride):
        line[i] = (line[i] + line[i - 4]) & 0xFF
    elif ftype == 2:
      for i in range(stride):
        line[i] = (line[i] + prev[i]) & 0xFF
    elif ftype == 3:
      for i in range(stride):
        left = line[i - 4] if i >= 4 else 0
        line[i] = (line[i] + ((left + prev[i]) >> 1)) & 0xFF
    elif ftype == 4:
      for i in range(stride):
        a = line[i - 4] if i >= 4 else 0
        b = prev[i]
        c = prev[i - 4] if i >= 4 else 0
        p = a + b - c
        pa, pb, pc = abs(p - a), abs(p - b), abs(p - c)
        pred = a if (pa <= pb and pa <= pc) else (b if pb <= pc else c)
        line[i] = (line[i] + pred) & 0xFF
    out[y * stride:(y + 1) * stride] = line
    prev = line
  return width, height, out


def write_png(path, width, height, pixels):
  raw = bytearray()
  stride = width * 4
  for y in range(height):
    raw.append(0)
    raw.extend(pixels[y * stride:(y + 1) * stride])

  def chunk(kind, body):
    return (struct.pack(">I", len(body)) + kind + body
            + struct.pack(">I", zlib.crc32(kind + body) & 0xFFFFFFFF))

  png = b"\x89PNG\r\n\x1a\n"
  png += chunk(b"IHDR", struct.pack(">IIBBBBB", width, height, 8, 6, 0, 0, 0))
  png += chunk(b"IDAT", zlib.compress(bytes(raw), 9))
  png += chunk(b"IEND", b"")
  path.write_bytes(png)


def px(pixels, width, x, y):
  i = (y * width + x) * 4
  return pixels[i], pixels[i + 1], pixels[i + 2], pixels[i + 3]


# ------------------------------------------------------------------- build


def icon_box(width, height, pixels):
  """Trim transparent margins without discarding the white mark."""
  x0, y0, x1, y1 = width, height, -1, -1
  for y in range(height):
    for x in range(width):
      if px(pixels, width, x, y)[3] > 0:
        x0, x1 = min(x0, x), max(x1, x)
        y0, y1 = min(y0, y), max(y1, y)
  if x1 < 0:
    raise SystemExit("no visible icon found in the logo")
  return x0, y0, x1, y1


def write_mark_svg(source, path, tinted=False):
  """Reuse the official 45:32 path with padding for small Qt textures."""
  root = ET.parse(source).getroot()
  ns = {"svg": "http://www.w3.org/2000/svg"}
  tile = root.find("svg:rect", ns)
  mark = root.find("svg:g/svg:path", ns)
  if tile is None or mark is None or not mark.get("d") or not tile.get("fill"):
    raise SystemExit("expected the official favicon's background tile and mark path")
  fill = "#ffffff" if tinted else tile.get("fill")
  svg = ET.Element("svg", {"xmlns": ns["svg"], "viewBox": "-1 -1 47 34"})
  ET.SubElement(svg, "path", {"fill": fill, "d": mark.get("d")})
  ET.indent(svg, space="  ")
  path.write_text(ET.tostring(svg, encoding="unicode") + "\n")
  print(f"{path.name}: official vector mark, {fill}")


def write_icon_png(width, pixels, box, path, target=256):
  """Downsample in premultiplied alpha, preserving the source's artwork."""
  x0, y0, x1, y1 = box
  icon_w, icon_h = x1 - x0 + 1, y1 - y0 + 1
  scale = max(1, (max(icon_w, icon_h) + target - 1) // target)
  out_w = (icon_w + scale - 1) // scale
  out_h = (icon_h + scale - 1) // scale
  small = bytearray(out_w * out_h * 4)
  for y in range(out_h):
    for x in range(out_w):
      r = g = b = a = count = 0
      for sy in range(y0 + y * scale, min(y0 + (y + 1) * scale, y1 + 1)):
        for sx in range(x0 + x * scale, min(x0 + (x + 1) * scale, x1 + 1)):
          sr, sg, sb, sa = px(pixels, width, sx, sy)
          r += sr * sa; g += sg * sa; b += sb * sa; a += sa
          count += 1
      o = (y * out_w + x) * 4
      if a:
        small[o:o + 4] = bytes((r // a, g // a, b // a, a // count))
  write_png(path, out_w, out_h, small)
  print(f"{path.name}: {out_w}x{out_h}, {path.stat().st_size} bytes")


def build(source: Path, mark_source: Path, out_dir: Path) -> None:
  width, height, pixels = read_png(source)
  print(f"source: {source} ({width}x{height})")
  out_dir.mkdir(parents=True, exist_ok=True)
  write_mark_svg(mark_source, out_dir / "dim-mark-color.svg")
  write_mark_svg(mark_source, out_dir / "dim-mark.svg", tinted=True)
  write_icon_png(width, pixels, icon_box(width, height, pixels), out_dir / "dim-logo.png")


def load_source(source: str, url: str, filename: str) -> Path:
  """Read a local source or fetch the current official artwork on each build."""
  if source:
    path = Path(source)
    if not path.is_file():
      raise SystemExit(f"no such logo: {path}")
    return path
  cache_dir = Path(os.environ.get("XDG_CACHE_HOME") or (Path.home() / ".cache")) / "omarchy-dim"
  cache = cache_dir / filename
  print(f"fetching {url}")
  cache_dir.mkdir(parents=True, exist_ok=True)
  staged = cache.with_suffix(".part")
  urllib.request.urlretrieve(url, staged)
  staged.replace(cache)
  return cache


def main(argv):
  parser = argparse.ArgumentParser(description="Build the plugin's logo assets from Dim's published logo.")
  parser.add_argument("--source", default="", metavar="PATH", help="a logo PNG to read instead of downloading")
  parser.add_argument("--mark-source", default="", metavar="PATH", help="an official favicon SVG instead of downloading")
  parser.add_argument("--out", default=str(PLUGIN_ROOT / "assets"), metavar="DIR", help="where to write the assets")
  args = parser.parse_args(argv)
  build(load_source(args.source, LOGO_URL, "dim-logo.png"),
        load_source(args.mark_source, MARK_URL, "dimagent-favicon.svg"), Path(args.out))
  return 0


if __name__ == "__main__":
  sys.exit(main(sys.argv[1:]))
